<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_radio_fallback" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/player_widget_empty"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/player_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/refresh_bg"
                android:contentDescription="@string/action_previous"
                android:padding="8dp"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/player_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/refresh_bg"
                android:contentDescription="@string/action_play"
                android:padding="8dp"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/player_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/refresh_bg"
                android:contentDescription="@string/action_next"
                android:padding="8dp"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
